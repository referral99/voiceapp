# ============================================================================
# Anonymous Connect - environment variables
# Copy this file to `.env` and fill in real values for your deployment.
# In production, set these as your cloud provider's environment variables.
# ============================================================================

# --- Core Django ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated list of hostnames your app is served from.
DJANGO_ALLOWED_HOSTS=decentapp.org,www.decentapp.org,13.60.20.71,127.0.0.1,localhost
# Comma-separated https origins (required for CSRF behind HTTPS).
CSRF_TRUSTED_ORIGINS=https://decentapp.org,https://www.decentapp.org
DJANGO_LOG_LEVEL=INFO

# --- Database (PostgreSQL recommended for production) ---
# Set DB_ENGINE=postgres to use Postgres; leave unset/sqlite to use SQLite.
DB_ENGINE=postgres
DB_NAME=anonymous_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Redis channel layer (REQUIRED in production for WebSockets) ---
# Without this the app falls back to an in-memory layer that only works with a
# single process and will NOT scale. Use your provider's Redis URL.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Activity report (/report.html) ---
# Password-protected analytics dashboard built from the activity log.
# Set REPORT_ENABLED=True to expose /report.html; leave False to hide it (404).
REPORT_ENABLED=False
# HTTP Basic Auth credentials used to access the report.
REPORT_USERNAME=admin
REPORT_PASSWORD=change-me-to-a-strong-password
# Compute the "visitors by gender" section (True/False).
REPORT_GENDER_BREAKDOWN=True
# Resolve visitor IPs to countries (uses ip-api.com + on-disk cache).
# Set False for a fully offline report.
REPORT_GEO_LOOKUP=True

# --- Razorpay payments ---
RAZOR_KEY_ID=
RAZOR_KEY_SECRET=

# --- Email (for allauth verification / password reset) ---
# Leave EMAIL_HOST blank in dev to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@decentapp.org
# allauth email verification: 'mandatory', 'optional', or 'none'
ACCOUNT_EMAIL_VERIFICATION=mandatory

# --- HTTPS hardening (enable once you have TLS in front of the app) ---
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Cloudflare Realtime TURN (WebRTC voice relay) ---
# Create a TURN key in the Cloudflare dashboard (Realtime > TURN) and paste the
# Turn Token ID + API Token here. Required so voice calls work across strict
# NATs / firewalls; without it calls fall back to STUN-only and may fail.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Credential lifetime in seconds (optional; defaults to 86400 = 24h).
CLOUDFLARE_TURN_TTL=86400

# --- Twilio (optional, for real OTP SMS) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
